---
import BaseLayout from '../layouts/BaseLayout.astro';
import { listPublishedElectionContexts } from '../lib/load-guide-data';

const contexts = await listPublishedElectionContexts();
---

<BaseLayout title="Zdroje podľa mesta a roku | ovolbach.sk" description="Vyberte mesto a rok a otvorte register verejných zdrojov použitých pri údajoch o voľbách." pageKind="collection" breadcrumbs={[{ label: 'Mestá a roky', href: '/' }, { label: 'Zdroje', href: '/zdroje/' }]}>
  <h1>Zdroje</h1>
  <p>Vyberte mesto a rok, pre ktoré chcete zobraziť register zdrojov.</p>
  <ul class="city-year-catalogue">
    {contexts.map((context) => (
      <li><a href={`${context.basePath}zdroje/`}>{context.cityName} — {context.year}</a></li>
    ))}
  </ul>
  <p>V registri nájdete vydavateľa, dátum overenia a odkaz na pôvodný dokument. Postup práce so zdrojmi opisuje <a href="/metodika/">metodika</a>.</p>
</BaseLayout>
