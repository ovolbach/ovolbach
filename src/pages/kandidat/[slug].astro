---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ClaimSection from '../../components/ClaimSection.astro';
import SourceLink from '../../components/SourceLink.astro';
import CandidacyFacts from '../../components/CandidacyFacts.astro';
import ComparisonSelection from '../../components/ComparisonSelection.astro';
import { getOfficialCandidacies } from '../../lib/official-facts';
import { loadGuideData } from '../../lib/load-guide-data';
import { getCandidateProfile } from '../../lib/selectors';
import { PROFILE_CATEGORIES } from '../../lib/profile-content';

export async function getStaticPaths() {
  const data = await loadGuideData();
  return data.candidates.map((candidate) => ({
    params: { slug: candidate.slug },
    props: { candidateId: candidate.id },
  }));
}

const { candidateId } = Astro.props;
const data = await loadGuideData();
const profile = getCandidateProfile(data, candidateId);
const candidacies = getOfficialCandidacies(data, candidateId);
---

<BaseLayout title={`${profile.candidate.displayName} | ovolbach.sk`} description={`Oficiálne údaje o kandidátovi ${profile.candidate.displayName}.`}>
  <article class="candidate-profile" data-candidate-profile data-candidate-id={profile.candidate.id}>
    <header>
      <h1>{profile.candidate.displayName}</h1>
      <SourceLink recordId={profile.candidate.id} sourceIds={profile.candidate.sourceIds} sources={data.sources} />
    </header>
    <ComparisonSelection candidateId={profile.candidate.id} candidateName={profile.candidate.displayName} />
    <ComparisonSelection />

    <section aria-labelledby="candidate-candidacies">
      <h2 id="candidate-candidacies">Oficiálne kandidátne údaje</h2>
      {candidacies.map((candidacy) => <CandidacyFacts candidacy={candidacy} />)}
    </section>

    {PROFILE_CATEGORIES.map((category) => (
      <ClaimSection
        title={category.title}
        claims={profile.claims.filter((claim) => claim.category === category.id)}
        coverage={profile.researchCoverage.find((coverage) => coverage.category === category.id)}
        sources={data.sources}
      />
    ))}
  </article>
</BaseLayout>
