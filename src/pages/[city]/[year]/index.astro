---
import MunicipalOverview from '../../../components/MunicipalOverview.astro';
import RegionalOverview from '../../../components/RegionalOverview.astro';
import { listPublishedElectionContexts, type ElectionContext } from '../../../lib/load-guide-data';
import { isRegionalContext, regionalContexts, type ProfilePageContext } from '../../../lib/regional-context';

export async function getStaticPaths() {
  const cities = await listPublishedElectionContexts();
  return [
    ...cities.map((context) => ({
      params: { city: context.citySlug, year: String(context.year) }, props: { context },
    })),
    ...regionalContexts(cities).map((context) => ({
      params: { city: context.regionSlug, year: String(context.year) },
      props: { context, cityContexts: cities.filter((city) => city.regionSlug === context.regionSlug && city.year === context.year) },
    })),
  ];
}

interface Props { context: ProfilePageContext; cityContexts?: ElectionContext[]; }
const { context, cityContexts = [] } = Astro.props;
---

{isRegionalContext(context)
  ? <RegionalOverview context={context} cityContexts={cityContexts} />
  : <MunicipalOverview context={context} />}
