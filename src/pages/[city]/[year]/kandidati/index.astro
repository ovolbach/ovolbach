---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import BallotSection from '../../../../components/BallotSection.astro';
import SourceLink from '../../../../components/SourceLink.astro';
import ComparisonSelection from '../../../../components/ComparisonSelection.astro';
import DistrictSelector from '../../../../components/DistrictSelector.astro';
import { listPublishedElectionContexts, type ElectionContext } from '../../../../lib/load-guide-data';
import { getBallotsForDistrict } from '../../../../lib/selectors';
import { getCityDistrictUrlMappings } from '../../../../lib/district-url';

export async function getStaticPaths() {
  return (await listPublishedElectionContexts()).map((context) => ({
    params: { city: context.citySlug, year: String(context.year) }, props: { context },
  }));
}

const context = Astro.props.context as ElectionContext;
const data = context.data;
const districtMappings = getCityDistrictUrlMappings(data.districts);
const districtsById = new Map(data.districts.map((district) => [district.id, district]));
const commonBallots = getBallotsForDistrict(data, districtMappings[0]!.internalId, context.regionalDistrictId).filter((ballot) => ballot.election.id !== 'city-council');
---

<BaseLayout title={`Kandidáti | ${context.cityName} ${context.year} | ovolbach.sk`} description={`Oficiálne zoznamy kandidátov vo voľbách v meste ${context.cityName}.`} context={context} pageKind="collection" breadcrumbs={[{ label: 'Mestá a roky', href: '/' }, { label: `${context.cityName} ${context.year}`, href: context.basePath }, { label: 'Kandidáti', href: `${context.basePath}kandidati/` }]}>
  <h1>Kandidáti</h1>
  <form class="election-selector" data-election-form>
    <label for="election">Voľby</label>
    <select id="election" name="volby" data-election-select>
      <option value="">Vyberte voľby</option>
      {data.elections.map((election) => <option value={election.id}>{election.title.sk}</option>)}
    </select>
    <button type="submit">Zobraziť voľby</button>
  </form>
  <DistrictSelector mappings={districtMappings} action={`${context.basePath}kandidati/`} />
  <ComparisonSelection basePath={context.basePath} />
  <div class="candidate-catalogue">
    {commonBallots.map((ballot) => (
      <div data-catalogue-election={ballot.election.id}>
        <BallotSection ballot={ballot} sources={data.sources} headingLevel="h2" basePath={context.basePath} />
      </div>
    ))}
    {districtMappings.map((mapping) => {
      const district = districtsById.get(mapping.internalId)!;
      const ballot = getBallotsForDistrict(data, district.id, context.regionalDistrictId).find((item) => item.election.id === 'city-council');
      return ballot && (
        <section id={mapping.publicId} data-district={district.id} data-election="city-council" data-catalogue-election="city-council">
          <header data-district-facts>
            <h2>{district.name}</h2>
            <p>{district.areas.join(', ')} Počet mandátov: {district.seats}. <SourceLink recordId={district.id} sourceIds={district.sourceIds} sources={data.sources} /></p>
          </header>
          <BallotSection ballot={ballot} sources={data.sources} basePath={context.basePath} />
        </section>
      );
    })}
  </div>
  <noscript><p>Filter volieb a porovnanie vyžadujú JavaScript. Rýchly výber obvodu sprístupní mestský zoznam; ostatné voľby sú uvedené samostatne.</p></noscript>
  <script>
    import '../../../../scripts/district-selection';
  </script>
</BaseLayout>
