---
import SourceLink from './SourceLink.astro';
import { financeDutyText, financeSourceIds, getFinanceDuties, partyFinanceSourceIds, reportDeadline } from '../lib/campaign-finance';
import type { CampaignFinance, FinanceParty, Source } from '../lib/schemas';
import type { OfficialCandidacy } from '../lib/official-facts';

interface Props { record: CampaignFinance; parties: FinanceParty[]; sources: Source[]; partyNominations: OfficialCandidacy[]; hasIndependentCandidacy: boolean }
const { record, parties, sources, partyNominations, hasIndependentCandidacy } = Astro.props;
const hasPartyNomination = parties.length > 0;
const duties = getFinanceDuties(record);
const eligibleHead = record.headCandidacies.some((head) => head.office === 'region-chair' || (head.population ?? 0) > 5000);
const dateSk = (value: string) => new Date(`${value}T00:00:00Z`).toLocaleDateString('sk-SK', { timeZone: 'UTC' });
const deadline = reportDeadline(record.electionDate);
const beforeDeadline = record.checkedAt <= deadline;
const sourceIds = [...new Set([...financeSourceIds(record), ...parties.flatMap(partyFinanceSourceIds)])];
const operatorLabels = { unknown: hasPartyNomination ? 'Z overených zdrojov nie je určené, či výdavky znáša kandidát, politická strana alebo obaja.' : 'Z overených zdrojov nie je určené, či kandidát vynakladá prostriedky na vlastnú kampaň.', candidate: 'Kandidát.', party: 'Politická strana.', both: 'Kandidát aj politická strana.', none: 'Kampaň sa nevedie.' };
const { account: accountText, report: reportText } = financeDutyText(record, hasPartyNomination);
---

<section class="campaign-finance" data-campaign-finance aria-labelledby="campaign-finance-title">
  <h2 id="campaign-finance-title">Financovanie volebnej kampane</h2>
  <p class="campaign-finance__date">Voľby {dateSk(record.electionDate)} · Overené {record.checkedAt}</p>
  <dl class="campaign-finance__facts">
    <div><dt>Povinnosť transparentného účtu kandidáta</dt><dd data-finance-account-duty={duties.account}>{accountText}</dd></div>
    <div>
      <dt>Transparentný účet kandidáta</dt>
      <dd>
        {record.account.status === 'verified' ? (
          <a data-personal-account href={record.account.url} target="_blank" rel="noopener noreferrer">Otvoriť účet kandidáta (nové okno)</a>
        ) : record.account.status === 'unverified' ? record.account.reason : (
          'V registri účtov kandidátov MV SR sa záznam pod týmto menom nenašiel. To nepotvrdzuje, že účet neexistuje alebo že došlo k porušeniu zákona.'
        )}
      </dd>
    </div>
    <div><dt>Vedenie a financovanie kampane</dt><dd>{operatorLabels[record.campaignOperator]}</dd></div>
    <div>
      <dt>Verejná správa kandidáta o výdavkoch</dt>
      <dd data-finance-report-duty={duties.report}>
        {reportText}
        {eligibleHead && duties.report !== 'not_required' && <p>Lehota na zverejnenie na vlastnom webe a doručenie MV SR: {dateSk(deadline)}. Správa zahŕňa výdavky, nie iba pohyby na účte.</p>}
        {record.reportSourceId ? <SourceLink recordId={`${record.id}-report`} sourceIds={[record.reportSourceId]} sources={sources} /> : eligibleHead && duties.report !== 'not_required' && (
          <p>{beforeDeadline ? 'Lehota ešte neuplynula. Odkaz na správu zatiaľ neuvádzame.' : `Odkaz na správu nemáme overený k ${record.checkedAt}.`}</p>
        )}
      </dd>
    </div>
  </dl>

  {hasPartyNomination && (
    <>
      <h3>Transparentné účty a správy politických strán</h3>
      {hasIndependentCandidacy && partyNominations.length > 0 && <p data-party-nominations>Stranícke nominácie tohto kandidáta: {partyNominations.map((nomination) => `${nomination.election} — ${nomination.affiliation}`).join('; ')}. V ďalšej overenej kandidatúre vystupuje ako nezávislý kandidát.</p>}
      <p>Uvedené sú strany z overených nominácií. Odkaz na účet strany nepotvrdzuje financovanie tohto kandidáta; transakcie celej strany nemožno priradiť jednému kandidátovi.</p>
      <ul class="campaign-finance__parties">
        {parties.map((party) => (
          <li>
            <strong>{party.name}</strong>
            <p>{party.account.status === 'registered' ? <a data-party-account data-party-id={party.id} href={party.account.url} target="_blank" rel="noopener noreferrer">Transparentný účet strany (nové okno)</a> : 'Odkaz na účet sa v registri MV SR nenašiel.'}</p>
            <p>Správa strany: {party.reportSourceId ? <SourceLink recordId={`${party.id}-report`} sourceIds={[party.reportSourceId]} sources={sources} /> : `Ak strana vedie kampaň, zverejní a predloží vlastnú správu do ${dateSk(reportDeadline(party.electionDate))}. ${party.checkedAt <= reportDeadline(party.electionDate) ? 'Lehota ešte neuplynula.' : 'Odkaz na správu nemáme overený.'}`}</p>
          </li>
        ))}
      </ul>
    </>
  )}

  <h3>Právny základ a rozsah overenia</h3>
  <p>Zákon č. 181/2014 Z. z. o volebnej kampani, znenie účinné od 1. 8. 2022: účet kandidáta § 6 ods. 8 a 9; správa kandidáta § 6 ods. 15.{hasPartyNomination && ' Vlastná kampaň straníckeho kandidáta § 6 ods. 17; účet a správa strany § 7 ods. 1 v spojení s § 3 ods. 2 až 9 a § 4.'}</p>
  {record.headCandidacies.length > 0 && (
    <>
      <p>Overené kandidatúry na funkciu predsedu kraja, starostu alebo primátora, ktoré vstupujú do posúdenia:</p>
      <ul>{record.headCandidacies.map((head) => <li>{head.office === 'region-chair' ? 'Predseda kraja' : 'Starosta / primátor'} — {head.locality}{head.population !== undefined ? ` (${head.population.toLocaleString('sk-SK')} obyvateľov; úradne zverejnený počet pre voľby)` : ''}.</li>)}</ul>
    </>
  )}
  <p>{record.candidacySearchNote} {record.otherCandidacies === 'not_exhaustive' && !eligibleHead && 'Prípadná ďalšia kandidatúra na predsedu kraja alebo na starostu či primátora obce nad 5 000 obyvateľov môže zmeniť povinnosť účtu a správy.'}</p>
  <details>
    <summary>Zdroje financovania a právnych pravidiel</summary>
    <SourceLink recordId={record.id} sourceIds={sourceIds} sources={sources} />
  </details>
</section>
