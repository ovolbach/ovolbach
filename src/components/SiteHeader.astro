---
import { SITE_TITLE } from '../config/site';
import { isRegionalContext, type ProfilePageContext } from '../lib/regional-context';
interface Props { context?: ProfilePageContext | undefined }
const { context } = Astro.props;
const municipal = context && !isRegionalContext(context);
---

<header class="site-header" data-pagefind-ignore>
  <div class="shell site-header__inner">
    <a class="site-title" href="/">{SITE_TITLE}</a>
    <nav aria-label="Hlavná navigácia">
      <ul class="site-nav">
        <li><a href="/">Mestá, kraje a roky</a></li>
        {context && <li><a href={context.basePath}>Prehľad</a></li>}
        {context && <li><a href={municipal ? `${context.basePath}kandidati/` : `${context.basePath}#kandidati`}>Kandidáti</a></li>}
        {context && <li><a href={`${context.basePath}porovnat/`}>Porovnať</a></li>}
        {municipal && <li><a href={`${context.basePath}ako-volit/`}>Ako voliť</a></li>}
        <li><a href={municipal ? `${context.basePath}zdroje/` : '/zdroje/'}>Zdroje</a></li>
        <li><a href="/metodika/">Metodika</a></li>
      </ul>
    </nav>
  </div>
</header>
